# Proven — environment template (foundation)
# Copy to `.env` (gitignored). Never commit real secrets.

# --- API (Rust) ---
PROVEN_API_HOST=0.0.0.0
PROVEN_API_PORT=8080
RUST_LOG=info,tower_http=info

# --- Web (Next.js) ---
NEXT_PUBLIC_PROVEN_API_URL=http://127.0.0.1:8080

# --- Go workers (health ports; foundation mode) ---
PROVEN_WORKER_NOTIFY_PORT=8091
PROVEN_WORKER_TEMPORAL_IO_PORT=8092
PROVEN_WORKER_MEDIA_PORT=8093
PROVEN_WORKER_ANALYTICS_PORT=8094

# --- Dependencies (docker/compose) — unused by foundation binaries yet ---
DATABASE_URL=postgres://proven:proven@127.0.0.1:5432/proven
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
TEMPORAL_ADDRESS=127.0.0.1:7233
