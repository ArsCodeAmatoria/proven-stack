# Proven — environment template (foundation)
#
# Copy to `.env` for local development (gitignored).
# Per-environment templates also live under `config/examples/`.
#
# Never commit real secrets. Production values come from the secret store
# (Fly secrets, Vercel env, GitHub Actions environments).

# =============================================================================
# Environment selection
# =============================================================================
# development | testing | production
PROVEN_ENV=development

# =============================================================================
# API (Rust) — loaded by crates/proven-config
# =============================================================================
PROVEN_API_HOST=0.0.0.0
PROVEN_API_PORT=8080
RUST_LOG=info,tower_http=info
PROVEN_SERVICE_NAME=proven-api
PROVEN_SERVICE_VERSION=0.1.0
PROVEN_LOG_JSON=false
PROVEN_METRICS_ENABLED=true
# OpenTelemetry (optional). Enable when a collector is running.
PROVEN_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
PROVEN_OTEL_SAMPLE_RATIO=1.0

# Session / cookie signing material (min 32 chars in production).
# Development may omit this; a weak default is injected locally only.
PROVEN_SESSION_SECRET=dev-only-session-secret-change-me-32b

# When true (default in development), missing infra does not abort API boot.
PROVEN_INFRA_OPTIONAL=true
PROVEN_DB_MAX_CONNECTIONS=10
PROVEN_DB_MIN_CONNECTIONS=1
PROVEN_DB_ACQUIRE_TIMEOUT_SECS=5
PROVEN_DB_IDLE_TIMEOUT_SECS=600
PROVEN_DB_MAX_LIFETIME_SECS=1800
PROVEN_MIGRATE_ON_START=true
PROVEN_MIGRATIONS_DIR=db/migrations/platform

# =============================================================================
# Web (Next.js) — loaded by @proven/config
# =============================================================================
# Browser / public URL (host-visible)
NEXT_PUBLIC_PROVEN_API_URL=http://localhost:8080
# Server-side URL (RSC). Inside Docker Compose use http://api:8080
PROVEN_API_URL=http://127.0.0.1:8080

# Better Auth (Next.js AuthN framework — no Postgres users yet)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prefer BETTER_AUTH_SECRET; falls back to PROVEN_SESSION_SECRET in development.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32b

# =============================================================================
# Go workers — loaded by go/internal/config
# =============================================================================
PROVEN_WORKER_HOST=0.0.0.0
PROVEN_WORKER_NOTIFY_PORT=8091
PROVEN_WORKER_TEMPORAL_IO_PORT=8092
PROVEN_WORKER_MEDIA_PORT=8093
PROVEN_WORKER_ANALYTICS_PORT=8094

# Shared worker runtime
PROVEN_LOG_LEVEL=debug
PROVEN_INFRA_OPTIONAL=true
PROVEN_SHUTDOWN_TIMEOUT_SEC=15
PROVEN_RETRY_MAX_ATTEMPTS=5
PROVEN_RETRY_INITIAL_MS=200
PROVEN_RETRY_MAX_MS=10000
# TEMPORAL_TASK_QUEUE=proven-notify

# =============================================================================
# Shared infrastructure endpoints
# Required in testing + production. Development supplies localhost defaults.
# =============================================================================
DATABASE_URL=postgres://proven:proven@127.0.0.1:5432/proven
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_URL=http://localhost:8088

# =============================================================================
# Cloudflare R2 (object storage) — optional until SigV4 signer is wired
# =============================================================================
# When unset, Core FileApi uses PlaceholderObjectStorage (URLs marked placeholder: true).
# See docs/development/FILE_MANAGEMENT.md and ADR-0010.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL=
