# Production environment example — PLACEHOLDERS ONLY.
# Real values must come from the platform secret store (never git).
# Startup validation rejects localhost endpoints and weak secrets.

PROVEN_ENV=production

PROVEN_API_HOST=0.0.0.0
PROVEN_API_PORT=8080
RUST_LOG=info,tower_http=warn

# Required: >= 32 characters, not a development placeholder.
PROVEN_SESSION_SECRET=REPLACE_WITH_PLATFORM_SECRET_MIN_32_CHARS
PROVEN_MIGRATE_ON_START=false
PROVEN_MIGRATIONS_DIR=db/migrations/platform
PROVEN_DB_MAX_CONNECTIONS=20
PROVEN_DB_MIN_CONNECTIONS=2

# Public browser origin (HTTPS). Must not be localhost.
NEXT_PUBLIC_PROVEN_API_URL=https://api.example.com
# Internal service URL as seen by the web runtime (may be private DNS).
PROVEN_API_URL=http://proven-api.internal:8080

PROVEN_WORKER_HOST=0.0.0.0
PROVEN_WORKER_NOTIFY_PORT=8091

# Required: non-placeholder credentials, non-loopback hosts.
DATABASE_URL=postgres://APP_USER:APP_PASSWORD@db.internal:5432/proven
REDIS_URL=rediss://:REDIS_TOKEN@redis.internal:6379
NATS_URL=tls://nats.internal:4222
TEMPORAL_ADDRESS=temporal.internal:7233
TEMPORAL_NAMESPACE=default
