# Testing environment example — CI / integration.
# Inject real values via GitHub Actions secrets or a local .env.testing.
# Placeholders below are intentionally incomplete so loaders fail closed
# until replaced.

PROVEN_ENV=testing

PROVEN_API_HOST=0.0.0.0
PROVEN_API_PORT=8080
RUST_LOG=info
PROVEN_SESSION_SECRET=testing-session-secret-16+
PROVEN_INFRA_OPTIONAL=false
PROVEN_MIGRATE_ON_START=true
PROVEN_MIGRATIONS_DIR=db/migrations/platform
PROVEN_DB_MAX_CONNECTIONS=5

NEXT_PUBLIC_PROVEN_API_URL=http://127.0.0.1:8080
PROVEN_API_URL=http://127.0.0.1:8080

PROVEN_WORKER_HOST=0.0.0.0
PROVEN_WORKER_NOTIFY_PORT=8091

# Replace with ephemeral CI database credentials (not proven:proven).
DATABASE_URL=postgres://proven_test:proven_test@127.0.0.1:5432/proven_test
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=testing
